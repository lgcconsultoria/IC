# Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...

# URL da API NestJS na Vercel (obrigatório em produção)
NEXT_PUBLIC_API_URL=https://ic-api.vercel.app

# Modo demonstração (opcional). "1" liga dados fictícios (pacientes/alertas/métricas)
# para apresentações comerciais. DESLIGADO por padrão: o cliente vê apenas dados
# reais e estados vazios ("aguardando sincronização") quando ainda não há dados.
NEXT_PUBLIC_DEMO=
