# ----- Supabase -----
# Projeto Supabase (Settings > API)
SUPABASE_URL=
# Secret key (sb_secret_...) — APENAS no backend, faz bypass de RLS. NUNCA expor.
SUPABASE_SECRET_KEY=
# String de conexao do Postgres (Settings > Database). Usada por Prisma/migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ----- API (NestJS) -----
API_PORT=3333
JWT_SECRET=

# ----- Frontend (Next.js) -----
NEXT_PUBLIC_API_URL=http://localhost:3333
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) — segura no navegador com RLS ativo.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ----- Redis (filas BullMQ) -----
REDIS_URL=redis://localhost:6379

# ----- ROOK (wearables) -----
ROOK_CLIENT_UUID=5e8699f1-f39b-41eb-972d-77cd9c1d76bb
ROOK_SECRET=
# "sandbox" (padrão) ou "production"
ROOK_ENV=sandbox

# ----- Terra API (legado) -----
TERRA_API_KEY=
TERRA_DEV_ID=
TERRA_SIGNING_SECRET=

# ----- Claude AI (relatórios) -----
CLAUDE_API_KEY=

# ----- Frontend: ROOK Connection Page -----
NEXT_PUBLIC_ROOK_CLIENT_UUID=5e8699f1-f39b-41eb-972d-77cd9c1d76bb

# ----- E-mail (relatórios/alertas) -----
RESEND_API_KEY=
