# ----- Supabase -----
# Projeto Supabase (Settings > API)
SUPABASE_URL=
# Secret key (sb_secret_...) — APENAS no backend, faz bypass de RLS. NUNCA expor.
SUPABASE_SECRET_KEY=
# String de conexao do Postgres (Settings > Database). Usada por Prisma/migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ----- API (NestJS) -----
API_PORT=3333
JWT_SECRET=

# ----- Frontend (Next.js) -----
NEXT_PUBLIC_API_URL=http://localhost:3333
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) — segura no navegador com RLS ativo.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ----- Redis (filas BullMQ) -----
REDIS_URL=redis://localhost:6379

# ----- Terra API (wearables) -----
TERRA_API_KEY=
TERRA_DEV_ID=
TERRA_SIGNING_SECRET=

# ----- IA multimodal (calorias por foto) -----
# Use uma das opções conforme o provedor escolhido
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ----- E-mail (relatórios/alertas) -----
RESEND_API_KEY=
