# ----- Supabase -----
# Projeto Supabase (Settings > API)
SUPABASE_URL=
# Secret key (sb_secret_...) — APENAS no backend, faz bypass de RLS. NUNCA expor.
SUPABASE_SECRET_KEY=
# String de conexao do Postgres (Settings > Database). Usada por Prisma/migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ----- API (NestJS) -----
API_PORT=3333
JWT_SECRET=

# ----- Frontend (Next.js) -----
NEXT_PUBLIC_API_URL=http://localhost:3333
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) — segura no navegador com RLS ativo.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ----- Redis (filas BullMQ) -----
REDIS_URL=redis://localhost:6379

# ----- Garmin (wearables via sidecar) -----
# URL interna do sidecar Python (apps/connector-garmin), na rede privada do host.
GARMIN_CONNECTOR_URL=http://localhost:8000
# Segredo compartilhado com o sidecar (header X-Connector-Secret). Use o MESMO valor lá.
GARMIN_CONNECTOR_SECRET=
# Chave AES-256 (base64 de 32 bytes) p/ criptografar token/senha Garmin. NUNCA no banco.
# Gerar: openssl rand -base64 32
GARMIN_TOKEN_KEY=
# Guardar a senha (criptografada) p/ re-login silencioso quando o token expira. "false" p/ desativar.
GARMIN_STORE_PASSWORD=true
# Dias de histórico puxados no backfill inicial ao conectar.
GARMIN_BACKFILL_DAYS=30
# Poller: intervalo entre coletas (ms) e liga/desliga. Só roda com REDIS_URL (host persistente).
GARMIN_POLL_INTERVAL_MS=21600000
GARMIN_POLL_ENABLED=true

# ----- Claude AI (relatórios) -----
CLAUDE_API_KEY=

# ----- E-mail (relatórios/alertas) -----
RESEND_API_KEY=
